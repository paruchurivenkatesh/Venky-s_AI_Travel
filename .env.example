# ==============================================================================
# VENKY'S AI TRAVEL — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Mode
DEMO_MODE=true

# Security & Authentication
JWT_SECRET_KEY=venkys-secret-travel-key-2026-production-ready
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default: SQLite for local; or Supabase PostgreSQL URI)
DATABASE_URL=sqlite:///./venkys_travel.db

# LLM Providers (Gemini / OpenAI)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Google Maps / Places API
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAPS_ID=

# Koson India Hotel API (https://api-gitbook.kosontechnology.com/india-hotel)
KOSON_API_KEY=

# Government Open Data Platforms
DATA_GOV_API_KEY=
API_SETU_API_KEY=
INDIAN_DATA_PROJECT_API_KEY=

# Supabase (Optional for cloud production)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
